# Template — copier vers .env.local et remplir avec vos vraies clés.
# Ne JAMAIS commiter .env.local (déjà dans .gitignore).

# --- Supabase ---
# Project Settings → API dans le dashboard Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...           # clé publique (non utilisée côté Cloudflare, réservée pour usage futur)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # clé secrète (admin / import) — ne jamais exposer côté navigateur

# --- Cloudflare Deploy Hook (optionnel) ---
# Workers & Pages → Settings → Build → Deploy Hooks dans le dashboard Cloudflare.
# Permet de déclencher un rebuild sans push : curl -X POST $CLOUDFLARE_DEPLOY_HOOK
CLOUDFLARE_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxxxxxx
