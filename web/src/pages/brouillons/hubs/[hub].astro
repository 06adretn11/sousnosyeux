---
// =====================================================================
// Moteur de hub — porte 3.
//
// ⛔ BROUILLON. Cette route ne produit AUCUNE page dans le build par
//    défaut : `getStaticPaths` renvoie une liste vide tant que la
//    variable d'environnement SNY_DRAFTS ne vaut pas '1'.
//
//    Build public  : npm run build              → 0 hub
//    Revue locale  : npm run build:drafts       → N hubs, noindex
//
//    Le contrôle scripts/qa/check-public-surface.mjs échoue si un
//    brouillon de hub apparaît dans web/dist.
//
// Le rendu est alimenté par un PAYLOAD figé et haché (data/hub-drafts/).
// Aucune donnée n'est saisie dans ce fichier : tous les compteurs sont
// dérivés en amont par scripts/build-hubs.mjs.
// =====================================================================

const DRAFTS_ENABLED = import.meta.env.SNY_DRAFTS === '1' || process.env.SNY_DRAFTS === '1';

export async function getStaticPaths() {
  const enabled = import.meta.env.SNY_DRAFTS === '1' || process.env.SNY_DRAFTS === '1';
  if (!enabled) return [];

  const modules = import.meta.glob('../../../../../data/hub-drafts/*.json', { eager: true });
  return Object.entries(modules)
    .filter(([path]) => !path.includes('INELIGIBLE'))
    .map(([, mod]) => {
      const env = (mod as any).default ?? mod;
      return { params: { hub: env.payload.hub_id }, props: { env } };
    });
}

interface Props { env: any }
const { env } = Astro.props as Props;

const p = env?.payload;
const statutLabels: Record<string, string> = {
  'plainte': 'Plainte',
  'enquête': 'Enquête',
  'mise en examen': 'Mise en examen',
  'procès': 'Procès',
  'condamnation non définitive': 'Condamnation non définitive',
  'condamnation définitive': 'Condamnation définitive',
  'relaxe / non-lieu / classement': 'Relaxe / non-lieu / classement',
  'à qualifier': 'À qualifier',
};

// Wording imposé par statut — EDITORIAL_CONTRACT_V0 §2.
const wording: Record<string, string> = {
  'plainte': 'Une source publique rapporte qu’une plainte a été déposée.',
  'enquête': 'Une source publique rapporte qu’une enquête a été ouverte.',
  'mise en examen': 'Une source publique rapporte une mise en examen.',
  'procès': 'Une source publique rapporte qu’un procès est en cours.',
  'condamnation non définitive': 'Une source publique rapporte une condamnation non définitive, susceptible d’appel.',
  'condamnation définitive': 'Une source publique rapporte une condamnation définitive.',
  'relaxe / non-lieu / classement': 'Une source publique rapporte une relaxe, un non-lieu ou un classement sans suite.',
};
const RAPPEL_PRESOMPTION = new Set(['plainte', 'enquête', 'mise en examen', 'procès']);

const statutCat = (s: string) =>
  ['condamnation définitive', 'condamnation non définitive'].includes(s) ? 'red'
  : ['mise en examen', 'enquête', 'procès'].includes(s) ? 'blue'
  : ['plainte', 'à qualifier'].includes(s) ? 'orange'
  : 'green';

const totalStatuts = Object.values(p?.compteurs?.par_statut ?? {}).reduce((a: number, b: any) => a + b, 0);
---

{DRAFTS_ENABLED && p && (
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>[BROUILLON] {p.zone_label} — sousnosyeux</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap"
    rel="stylesheet"
  />
</head>
<body>

  <!-- Bandeau de brouillon. N'existe QUE dans les rendus de revue. -->
  <div class="draft-banner">
    <strong>BROUILLON — NE PAS PUBLIER</strong>
    <span>
      Rendu de revue · <code>noindex</code> · relié à aucune page publique ·
      hash <code>{env.payload_hash.slice(0, 16)}…</code> ·
      {env.publishable ? 'aucun contrôle bloquant' : `${env.bloquants} contrôle(s) bloquant(s)`}
    </span>
  </div>

  <main>
    <header class="hub-header">
      <p class="eyebrow">Zone · {p.zone_label}</p>
      <h1>Affaires signalées — {p.zone_label}</h1>
      <p class="subtitle">
        Structures accueillant des mineurs ·
        {p.verified_at
          ? ` Dernière vérification : ${p.verified_at}`
          : ' Aucune date de vérification disponible'}
      </p>
    </header>

    <section class="stats" aria-label="Chiffres clés">
      <div class="stats-inner">
        <span class="stat"><strong>{p.compteurs.affaires}</strong> affaires</span>
        <span class="stat"><strong>{p.compteurs.etablissements}</strong> établissements</span>
        {Object.entries(p.compteurs.par_statut).map(([s, n]) => (
          <span class="stat"><strong>{n}</strong> {statutLabels[s] ?? s}</span>
        ))}
      </div>
      <p class="stats-note">
        Compteurs dérivés des {p.compteurs.affaires} affaires retenues — jamais saisis.
        Somme des statuts : {totalStatuts}{totalStatuts === p.compteurs.affaires ? ' ✓' : ' ✗ incohérent'}
      </p>
    </section>

    <p class="method-note">
      Présomption d’innocence respectée. Toutes les informations proviennent de sources de presse
      publiques citées individuellement. Aucun nom de personne mise en cause n’est mentionné.
    </p>

    <section class="cases">
      <h2 class="section-title">{p.compteurs.affaires} affaires documentées</h2>
      <div class="case-list">
        {p.affaires.map((a: any) => (
          <article class={`case-card ${statutCat(a.statut_judiciaire)}`}>
            <h3 class="case-title">{a.etablissement}</h3>
            <p class="case-meta">{a.type_structure} · {a.commune} · {a.role_mis_en_cause}</p>
            <p class="case-summary">
              {wording[a.statut_judiciaire] ?? 'Une source publique rapporte des faits signalés.'}
              {RAPPEL_PRESOMPTION.has(a.statut_judiciaire) && (
                <em> Cela ne vaut pas culpabilité.</em>
              )}
            </p>
            <div class="case-tags">
              <span class="chip">{statutLabels[a.statut_judiciaire] ?? a.statut_judiciaire}</span>
              <span class="chip muted">{a.type_affaire}</span>
              <span class="chip muted">{a.enfants_concernes_public}</span>
            </div>
            <p class="case-sources">
              {(a.sources ?? []).map((s: any, i: number) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a href={s.url} target="_blank" rel="noreferrer">
                    {s.media}{s.publication_date ? `, ${s.publication_date}` : ' (source non datée)'} ↗
                  </a>
                </>
              ))}
              {(a.sources ?? []).length === 0 && <span class="ko">aucune source</span>}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="corrections">
      <h2 class="section-title">Corriger ou signaler</h2>
      <p>
        Une erreur, une évolution judiciaire, une relaxe, un non-lieu ou un classement ?
        Toute information sourcée est traitée en priorité.
        <a href="mailto:contact@sousnosyeux.org">contact@sousnosyeux.org</a>
      </p>
    </section>
  </main>

  <style>
    :root {
      /* Tokens extraits de la reconstruction Paris 11e V3. */
      --ink: #151517; --muted: #74747a; --paper: #f7f7f4; --card: #fff;
      --line: #e7e5e1; --red: #e63946; --blue: #457b9d; --orange: #d97706;
      --green: #2d6a4f;
      --sans: "DM Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: "DM Mono", "Courier New", monospace;
      --display: "Playfair Display", Georgia, serif;
      --shadow: 0 1px 0 rgb(22 22 24 / 4%), 0 8px 30px rgb(22 22 24 / 4%);
    }
    * , *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink);
           font: 16px/1.48 var(--sans); -webkit-font-smoothing: antialiased; }
    main { width: min(1160px, 100%); margin: 0 auto; padding: 0 22px 64px; }

    .draft-banner { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap;
      align-items: baseline; gap: 6px 14px; padding: 10px 22px; background: #2b0a10;
      color: #ffd9e0; border-bottom: 3px solid var(--red);
      font: 0.74rem/1.5 var(--mono); letter-spacing: 0.03em; text-transform: uppercase; }
    .draft-banner strong { color: #fff; }
    .draft-banner code { text-transform: none; }

    .hub-header { padding: 32px 0 20px; }
    .eyebrow { margin: 0 0 10px; color: var(--red); font: 0.74rem var(--mono);
               letter-spacing: 0.13em; text-transform: uppercase; }
    h1 { max-width: 820px; margin: 0;
         font: 700 clamp(1.9rem, 5vw, 3.4rem)/1.04 var(--display); letter-spacing: -0.03em; }
    .subtitle { margin: 12px 0 0; color: var(--muted); font-size: clamp(0.95rem, 2vw, 1.1rem); }

    .stats { margin: 8px 0 26px; }
    .stats-inner { display: flex; flex-wrap: wrap; gap: 10px 26px; padding: 20px 22px;
      background: #111113; color: #fff; border-radius: 3px; }
    .stat { white-space: nowrap; font-size: 0.86rem; }
    .stat strong { color: var(--red); font: 500 1.4rem var(--mono); margin-right: 5px; }
    .stats-note { margin: 8px 2px 0; color: var(--muted); font-size: 0.74rem; }

    .method-note { max-width: 800px; margin: 0 0 30px; padding: 16px 18px;
      background: var(--card); border-left: 3px solid var(--line);
      color: #6b696f; font-size: 0.89rem; font-style: italic; }

    .section-title { margin: 0 0 16px; padding-bottom: 8px; color: #77757a;
      border-bottom: 1px solid var(--line); font: 0.78rem var(--mono);
      font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; }

    .case-list { display: grid; gap: 13px; }
    .case-card { position: relative; padding: 18px 20px 16px 23px; background: var(--card);
      border: 1px solid var(--line); border-radius: 3px; box-shadow: var(--shadow); }
    .case-card::before { content: ""; position: absolute; inset: 16px auto 16px 0;
      width: 3px; background: var(--c, var(--blue)); }
    .case-card.red { --c: var(--red); } .case-card.blue { --c: var(--blue); }
    .case-card.orange { --c: var(--orange); } .case-card.green { --c: var(--green); }
    .case-title { margin: 0; font-size: 1.02rem; line-height: 1.25; }
    .case-meta { margin: 3px 0 10px; color: #858389; font-size: 0.8rem; }
    .case-summary { margin: 0 0 11px; color: #37363a; font-size: 0.92rem; }
    .case-summary em { color: var(--muted); }
    .case-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 9px; }
    .chip { padding: 3px 7px; background: #eaf4f8; color: #496b79;
      font: 0.66rem var(--mono); text-transform: uppercase; }
    .chip.muted { background: #f6f6f6; color: #66646a; text-transform: none; }
    .case-sources { margin: 0; font-size: 0.76rem; }
    .case-sources a { color: #777b80; }
    .ko { color: var(--red); font-weight: 600; }

    .corrections { margin-top: 38px; }
    .corrections p { max-width: 720px; color: #4d4b50; font-size: 0.92rem; }

    @media (max-width: 560px) {
      body { font-size: 15px; }
      main { padding: 0 18px 44px; }
      .stats-inner { gap: 10px 18px; padding: 16px 18px; }
      .stat strong { font-size: 1.2rem; }
      .case-card { padding: 16px 15px 14px 23px; }
    }
  </style>
</body>
</html>
)}
