---
// =====================================================================
// Prévisualisations « 3 hubs réels » — Paris 11e · Bordeaux/Gironde · Somme.
//
// ⛔ Même garde que les brouillons de hub : aucune page dans le build par
//    défaut (celui déployé sur Cloudflare). Elles n'existent que via
//    `npm run build:drafts` (SNY_DRAFTS=1), en noindex, sans lien depuis
//    le site public.
//
// Une seule route pour trois expériences volontairement différentes : le
// contenu de chaque vue vit dans son composant (components/territoires/).
// =====================================================================
import Layout from '../../../layouts/Layout.astro';
import Index from '../../../components/territoires/Index.astro';
import Paris11e from '../../../components/territoires/Paris11e.astro';
import Bordeaux from '../../../components/territoires/Bordeaux.astro';
import Somme from '../../../components/territoires/Somme.astro';
import { chargerHub } from '../../../lib/hub-matiere';

export function getStaticPaths() {
  const enabled = import.meta.env.SNY_DRAFTS === '1' || process.env.SNY_DRAFTS === '1';
  if (!enabled) return [];
  return [
    { params: { vue: undefined }, props: { vue: 'index' } },
    { params: { vue: 'paris-11e' }, props: { vue: 'paris-11e' } },
    { params: { vue: 'bordeaux-gironde' }, props: { vue: 'bordeaux-gironde' } },
    { params: { vue: 'somme' }, props: { vue: 'somme' } },
    // Versions « publique » : ce qui est publiable aujourd'hui, sans la matière de revue.
    { params: { vue: 'bordeaux-gironde-public' }, props: { vue: 'bordeaux-gironde-public' } },
    { params: { vue: 'somme-public' }, props: { vue: 'somme-public' } },
  ];
}

const { vue } = Astro.props as { vue: string };
// Un rendu qui contient de la matière NON PUBLIÉE (data/hub-prive/) le dit en tête de page.
const aPrive = ['paris-11e', 'bordeaux-gironde', 'somme'].some((id) => (vue === 'index' || vue === id) && chargerHub(id).prive);
const base = '/brouillons/territoires';
const titres: Record<string, string> = {
  'index': 'Trois territoires',
  'paris-11e': 'Paris 11e',
  'bordeaux-gironde': 'Bordeaux / Gironde',
  'somme': 'Somme (revue)',
  'bordeaux-gironde-public': 'Bordeaux / Gironde (public)',
  'somme-public': 'Somme (public)',
};
---

<Layout
  title={`[PRÉVISUALISATION] ${titres[vue]} — sousnosyeux`}
  description="Prévisualisation non publiée d'une expérience territoriale."
  noindex
>
  {aPrive && (
    <div class="apercu-prive">
      ⛔ RENDU LOCAL — CE RENDU CONTIENT DE LA MATIÈRE NON PUBLIÉE (data/hub-prive/, ignoré par Git).
      Ne jamais le déployer ni le partager : <code>noindex</code> n’est pas un mécanisme de confidentialité.
    </div>
  )}
  <div class="apercu">
    <strong>PRÉVISUALISATION — NON PUBLIÉE</strong>
    <span class="apercu-detail">noindex · hors build public · fiches : data/cases.json · matière : data/hub-matiere/</span>
    <nav>
      <a href={base}>Les trois</a>
      <a href={`${base}/paris-11e`}>Paris 11e</a>
      <a href={`${base}/bordeaux-gironde`}>Bordeaux (revue)</a>
      <a href={`${base}/bordeaux-gironde-public`}>Bordeaux (public)</a>
      <a href={`${base}/somme`}>Somme (revue)</a>
      <a href={`${base}/somme-public`}>Somme (public)</a>
    </nav>
  </div>
  {vue === 'index' && <Index />}
  {vue === 'paris-11e' && <Paris11e />}
  {vue === 'bordeaux-gironde' && <Bordeaux />}
  {vue === 'bordeaux-gironde-public' && <Bordeaux publicOnly />}
  {vue === 'somme' && <Somme />}
  {vue === 'somme-public' && <Somme publicOnly />}
</Layout>

<style is:global>
  .apercu { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; padding: 8px 20px;
    background: #2b0a10; color: #ffd9e0; border-bottom: 3px solid var(--red);
    font: 0.72rem/1.5 var(--mono); letter-spacing: 0.03em; }
  .apercu strong { color: #fff; }
  .apercu-prive { padding: 10px 20px; background: #b00020; color: #fff; font: 600 0.78rem/1.5 var(--mono); }
  .apercu nav { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-left: auto; }
  .apercu nav a { color: #ffd9e0; }
  /* Habillage commun des trois vues (mêmes variables que le reste du site). */
  .terr { max-width: 1060px; margin: 0 auto; padding: 1.4rem 1.2rem 3rem; }
  .terr h1 { font: 700 clamp(1.7rem, 4.5vw, 2.7rem)/1.08 var(--display); letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .terr .eyebrow { margin: 0 0 8px; color: var(--red); font: 0.72rem var(--mono); letter-spacing: 0.13em; text-transform: uppercase; }
  .terr .lede { max-width: 760px; color: #3d3d42; font-size: 1rem; margin: 0 0 1.2rem; }
  .terr h2 { margin: 2rem 0 0.8rem; padding-bottom: 6px; border-bottom: 1px solid var(--border);
    font: 400 0.76rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: #6b6b72; }
  .terr .encart { max-width: 820px; padding: 0.9rem 1.1rem; background: var(--bg-card); border-left: 3px solid var(--border);
    color: #55555b; font-size: 0.88rem; margin: 0 0 1rem; }
  .terr .encart.limites { border-left-color: var(--orange); }
  .terr .encart ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  .terr .grille { display: grid; gap: 12px; }
  @media (max-width: 600px) {
    .apercu { padding: 6px 14px; } .apercu-detail { display: none; }
    .apercu nav { flex-wrap: nowrap; overflow-x: auto; margin-left: 0; width: 100%; white-space: nowrap; }
    .apercu-prive { padding: 6px 14px; font-size: 0.68rem; }
  }
</style>
