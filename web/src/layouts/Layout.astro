---
interface Props {
  title: string;
  description: string;
  variant?: 'map' | 'page';
  /** Prévisualisations : jamais indexées. Absent = comportement inchangé. */
  noindex?: boolean;
  /** Données structurées de la page (WebSite, BreadcrumbList) : décrivent seulement ce que la page affiche. */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}

// Polices auto-hébergées (fontsource, licence OFL-1.1) : mêmes familles et graisses que l'ancien appel Google Fonts, sous-ensembles latin + latin-ext.
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-ext-400.css';
import '@fontsource/dm-sans/latin-400-italic.css';
import '@fontsource/dm-sans/latin-ext-400-italic.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-ext-500.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/dm-sans/latin-ext-700.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-ext-400.css';
import '@fontsource/dm-mono/latin-500.css';
import '@fontsource/dm-mono/latin-ext-500.css';
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-ext-700.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/playfair-display/latin-ext-400-italic.css';

const { title, description, variant = 'page', noindex = false, jsonld } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const SITE = Astro.site ?? 'https://sousnosyeux.org';
// Canonical : l'URL finale servie de la page elle-même (barre finale, ni paramètre ni fragment), sur l'origine publique.
// Absente des pages noindex (signaux contradictoires). Doit rester identique à l'URL listée dans /sitemap.xml (scripts/lib/sitemap.mjs).
const canonical = new URL(path === '/' ? '/' : path + '/', SITE).href;
// Aperçu de partage : image GÉNÉRIQUE de marque (aucun contenu d'affaire), mêmes titre et description que la page.
const ogImage = new URL('/og-sousnosyeux.png', SITE).href;
// JSON-LD sérialisé sans possibilité de fermer la balise <script>.
const ld = jsonld ? JSON.stringify(jsonld).replace(/</g, '\\u003c') : null;

// Liens internes sous leur forme canonique (barre finale) : aucune redirection 307 depuis le menu.
const nav = [
  { href: '/', label: 'Carte', cta: false },
  { href: '/territoires/', label: 'Territoires', cta: false },
  { href: '/le-projet/', label: 'Le projet', cta: false },
  { href: '/methodologie/', label: 'Méthodologie', cta: false },
  { href: '/mentions-legales/', label: 'Mentions légales', cta: false },
  { href: 'mailto:contact@sousnosyeux.org', label: 'Nous contacter', cta: true },
];

const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,nofollow,noarchive" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="sousnosyeux" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sousnosyeux — carte des affaires signalées dans les lieux d’accueil des mineurs" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body data-variant={variant}>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="sousnosyeux — accueil">
          <span class="logo-bar" aria-hidden="true"></span>
          <span class="logo-text">sousnosyeux</span>
        </a>
        <nav aria-label="Navigation principale">
          <ul>
            {nav.map((n) => {
              const liClass =
                n.href === '/mentions-legales/' ? 'nav-mentions'
                : n.href === '/' ? 'nav-carte'
                : n.href === '/methodologie/' ? 'nav-methodo'
                : n.href === '/territoires/' ? 'nav-methodo'
                : n.href === '/le-projet/' ? 'nav-methodo'
                : undefined;
              return (
                <li class={liClass}>
                  <a
                    href={n.href}
                    aria-current={(!n.cta && isActive(n.href)) ? 'page' : undefined}
                    class={n.cta ? 'nav-cta' : undefined}
                  >
                    {n.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">sousnosyeux · carte citoyenne</div>
        <div class="footer-links">
          <a href="/territoires/">Territoires</a>
          <a href="/le-projet/">Le projet</a>
          <a href="/methodologie/">Méthodologie</a>
          <a href="/mentions-legales/">Mentions légales</a>
          <a href="mailto:contact@sousnosyeux.org">contact@sousnosyeux.org</a>
          <a href="https://github.com/06adretn11/sousnosyeux" rel="noopener noreferrer" target="_blank">Code source (AGPL)</a>
        </div>
        <div class="footer-legal">
          Données <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC-BY-SA 4.0</a>
          · Code <a href="https://www.gnu.org/licenses/agpl-3.0.html" rel="license">AGPL-3.0</a>
          · Dir. publication : Adrien Etienne
        </div>
      </div>
    </footer>

    <style is:global>
      /* ──────────────────────────────────────────────────
         DESIGN B2 — Variables & reset
         ────────────────────────────────────────────────── */
      :root {
        --bg:       #F8F8F6;
        --bg-card:  #FFFFFF;
        --text:     #111111;
        --muted:    #6B7280;
        --red:      #E63946;
        --red-bg:   #FEF2F2;
        --blue:     #457B9D;
        --blue-bg:  #DBEAFE;
        --green:    #2D6A4F;
        --green-bg: #D1FAE5;
        --orange:   #D97706;
        --orange-bg:#FEF3C7;
        --border:   #E5E5E3;
        --sans:     'DM Sans', system-ui, -apple-system, sans-serif;
        --mono:     'DM Mono', 'Courier New', monospace;
        --display:  'Playfair Display', Georgia, 'Times New Roman', serif;
        --safe-l: env(safe-area-inset-left, 0px);
        --safe-r: env(safe-area-inset-right, 0px);
        --safe-t: env(safe-area-inset-top, 0px);
        --safe-b: env(safe-area-inset-bottom, 0px);
        /* Hauteur header — utilisée pour le sticky toolbar */
        --header-h: 60px;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0; padding: 0;
        font-family: var(--sans);
        font-size: 16px;
        color: var(--text);
        background: var(--bg);
        -webkit-text-size-adjust: 100%;
      }

      a { color: var(--blue); }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100dvh;
      }
      main { flex: 1; }

      /* Variant carte : pas de bounce-scroll sur iOS, pas de scroll horizontal */
      body[data-variant="map"] { overscroll-behavior: none; overflow-x: hidden; }

      /* ── HEADER ── */
      .site-header {
        background: var(--bg-card);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        padding-top: var(--safe-t);
      }
      .header-inner {
        max-width: 1160px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: var(--header-h);
        padding: 0 1.25rem;
        gap: 1rem;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--text);
        flex-shrink: 0;
      }
      .logo-bar {
        display: block;
        width: 4px;
        height: 22px;
        background: var(--red);
        border-radius: 2px;
        flex-shrink: 0;
      }
      .logo-text {
        font-family: var(--mono);
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.5px;
      }

      .site-header nav ul {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.15rem 0.15rem;
        list-style: none;
        margin: 0; padding: 0;
        align-items: center;
      }
      /* Sur mobile : seul le bouton CTA reste visible — les autres liens sont dans le footer */
      .site-header nav li.nav-mentions,
      .site-header nav li.nav-carte,
      .site-header nav li.nav-methodo { display: none; }
      .site-header nav a {
        display: inline-block;
        padding: 0.3rem 0.5rem;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--muted);
        text-decoration: none;
        border-radius: 4px;
        transition: color 0.12s;
        white-space: nowrap;
      }
      .site-header nav a[aria-current="page"] {
        color: var(--text);
        border-bottom: 2px solid var(--red);
        border-radius: 0;
        padding-bottom: calc(0.35rem - 2px);
      }
      .site-header nav a:hover:not([aria-current="page"]):not(.nav-cta) {
        color: var(--text);
        background: #F3F3F1;
      }
      /* Bouton Contact dans le header */
      .site-header nav a.nav-cta {
        background: var(--red);
        color: white;
        border-radius: 4px;
        font-weight: 600;
        padding: 0.3rem 0.75rem;
      }
      .site-header nav a.nav-cta:hover {
        background: #CC2936;
        color: white;
      }

      /* ── FOOTER ── */
      .site-footer {
        background: #111111;
        color: #6B7280;
        font-size: 0.75rem;
        padding: 1.25rem calc(1.25rem + var(--safe-r)) calc(1.25rem + var(--safe-b)) calc(1.25rem + var(--safe-l));
      }
      .footer-inner {
        max-width: 1160px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .footer-brand {
        font-family: var(--mono);
        color: #FFFFFF;
        font-size: 0.85rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
      }
      .footer-links a {
        color: #9CA3AF;
        text-decoration: none;
      }
      .footer-links a:hover { color: white; }
      .footer-legal {
        color: #4B5563;
        line-height: 1.5;
      }
      .footer-legal a { color: #6B7280; }

      @media (min-width: 720px) {
        .footer-inner {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          flex-wrap: wrap;
          gap: 0.75rem 1.5rem;
        }
        .footer-links { flex-wrap: nowrap; }
      }

      /* ── PROSE (méthodologie, mentions légales) ── */
      .prose {
        max-width: 70ch;
        margin: 0 auto;
        padding: 1.5rem calc(1rem + var(--safe-r)) 3rem calc(1rem + var(--safe-l));
        line-height: 1.6;
      }
      .prose h1 {
        font-family: var(--display);
        font-size: 1.7rem;
        font-weight: 700;
        margin: 0 0 0.4rem;
        letter-spacing: -0.01em;
      }
      .prose .lede {
        color: var(--muted);
        font-size: 0.95rem;
        margin: 0 0 1.75rem;
        line-height: 1.6;
        border-left: 3px solid var(--red);
        padding-left: 0.85rem;
      }
      .prose h2 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 2rem 0 0.5rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.25rem;
      }
      .prose h3 { font-size: 0.95rem; font-weight: 700; margin: 1.25rem 0 0.3rem; }
      .prose p, .prose li { font-size: 0.9rem; }
      .prose p { margin: 0 0 0.8rem; }
      .prose ul, .prose ol { padding-left: 1.3rem; margin-bottom: 0.8rem; }
      .prose li { margin-bottom: 0.3rem; }
      .prose code {
        background: #EEEEED;
        padding: 0.1em 0.3em;
        border-radius: 3px;
        font-size: 0.85em;
        font-family: var(--mono);
      }
      .prose .callout {
        margin: 1.25rem 0;
        padding: 0.75rem 1rem;
        background: #FFF8E1;
        border-left: 3px solid #D97706;
        font-size: 0.88rem;
        border-radius: 0 4px 4px 0;
        line-height: 1.55;
      }
      .prose .callout-info  { background: #EEF3FB; border-left-color: var(--blue); }
      .prose .callout-danger { background: #FEF2F2; border-left-color: var(--red); }

      @media (min-width: 720px) {
        :root { --header-h: 60px; }
        .site-header nav li.nav-mentions,
        .site-header nav li.nav-carte,
        .site-header nav li.nav-methodo { display: list-item; }
        .site-header nav a { font-size: 0.875rem; padding: 0.4rem 0.75rem; }
        .prose { padding: 2.5rem 1rem 4rem; }
        .prose h1 { font-size: 2.1rem; }
      }
      /* Largeur intermédiaire : le menu complet (6 entrées) ne tient pas ; « Mentions légales » reste dans le pied de page. */
      @media (min-width: 720px) and (max-width: 819px) {
        .site-header nav li.nav-mentions { display: none; }
      }
    </style>
  </body>
</html>
