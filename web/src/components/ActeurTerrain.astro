---
// « ACTEUR DE TERRAIN » — ce qu'un collectif, une association ou un groupe de parents dit et demande dans SES documents, sans en faire des faits.
// Un seul composant pour toute fiche (et, plus tard, tout Hub) : il lit le champ optionnel `acteurs_de_terrain` du dossier (scripts/lib/acteurs-terrain.mjs).
// L'avertissement est une constante FIXE (non éditable) ; le libellé de chaque groupe vient de son genre : demande ≠ constat ≠ annonce rapportée ≠ question ouverte.
import { AVERTISSEMENT, GENRES } from '../../../scripts/lib/acteurs-terrain.mjs';
import { dateLongue } from '../lib/etat-wording';

interface Props { acteurs: any[] }
const { acteurs } = Astro.props;
const date = (s: any) => (s?.publie_le ? dateLongue(s.publie_le) : null);
---

<section class="acteurs" aria-label="Acteur de terrain" data-acteurs={acteurs.length}>
  <h2>Acteur de terrain</h2>
  <p class="avert">{AVERTISSEMENT}</p>
  {acteurs.map((a: any) => (
    <article class="acteur" data-acteur={a.acteur}>
      <p class="qui"><strong>{a.acteur}</strong> <span class="nature">— {a.nature}</span></p>
      <p class="pres">{a.presentation}</p>
      {(a.groupes ?? []).map((g: any) => (
        <div class={`groupe g-${g.genre}`}>
          <h3>{g.titre} <span class="genre">· {GENRES[g.genre] ?? g.genre}</span></h3>
          {g.precision && <p class="precision">{g.precision}</p>}
          <ul>
            {(g.points ?? []).map((p: any) => (
              <li>{p.texte} <a class="ref" href={a.sources?.[p.src]?.url} target="_blank" rel="noopener noreferrer">({a.sources?.[p.src]?.libelle ?? 'document'}) ↗</a></li>
            ))}
          </ul>
        </div>
      ))}
      {(a.limites ?? []).map((l: string) => <p class="limite">{l}</p>)}
      <p class="docs">Documents de l’acteur :
        {Object.values(a.sources ?? {}).map((s: any, k: number) => (<>{k > 0 ? ' · ' : ' '}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.libelle}{date(s) ? `, ${date(s)}` : ''} ↗</a></>))}
      </p>
    </article>
  ))}
</section>

<style>
  .avert { margin: 0 0 12px; padding: 8px 11px; font-size: 0.82rem; line-height: 1.45; color: #5b4300; background: #fdf6e3; border-left: 3px solid var(--orange); }
  .acteur { margin: 0 0 14px; padding: 12px 14px 8px; background: #fff; border: 1px solid var(--border); border-left: 4px solid var(--blue); }
  .qui { margin: 0 0 4px; font-size: 0.95rem; } .nature { color: var(--muted); font-size: 0.85rem; }
  .pres { margin: 0 0 10px; font-size: 0.9rem; line-height: 1.5; color: #2b2b30; }
  .groupe { margin: 0 0 12px; }
  h3 { margin: 0 0 4px; font: 700 0.88rem/1.3 var(--display); color: #16161a; } .genre { font: 0.66rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 400; }
  .precision { margin: 0 0 4px; font-size: 0.78rem; font-style: italic; color: var(--muted); }
  ul { margin: 0; padding-left: 1.1rem; font-size: 0.88rem; line-height: 1.5; color: #1f1f23; } li { margin: 3px 0; }
  .ref { font-size: 0.74rem; color: var(--blue); white-space: nowrap; }
  .limite { margin: 8px 0 0; font-size: 0.78rem; font-style: italic; color: var(--muted); }
  .docs { margin: 6px 0 4px; font-size: 0.76rem; color: var(--muted); } .docs a { color: var(--blue); }
</style>
