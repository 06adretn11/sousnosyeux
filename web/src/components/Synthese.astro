---
// « À retenir » : quelques paragraphes attribués, chacun relié à ses sources.
import { dateLongue } from '../lib/etat-wording';
interface Props { paragraphes: { texte: string; sources: { media: string; url: string; publie_le: string | null }[] }[] }
const { paragraphes } = Astro.props;
---

<div class="synthese">
  {paragraphes.map((p) => (
    <p>
      {p.texte}
      {p.sources.length > 0 && (
        <span class="src">
          {p.sources.map((s, i) => (
            <>{i > 0 && ' · '}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.media}{s.publie_le ? `, ${dateLongue(s.publie_le)}` : ''} ↗</a></>
          ))}
        </span>
      )}
    </p>
  ))}
</div>

<style>
  .synthese { max-width: 820px; }
  p { margin: 0 0 0.9rem; font-size: 1.02rem; line-height: 1.6; color: #26262a; }
  .src { display: block; margin-top: 3px; font-size: 0.74rem; color: var(--muted); }
  .src a { color: var(--blue); }
</style>
