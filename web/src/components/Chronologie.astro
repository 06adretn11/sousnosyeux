---
// Déroulé d'un dossier : une entrée = un fait attribué à une source, classé du plus ancien au plus récent.
// Repère (scripts/lib/chronologie.mjs) : date de l'ÉVÉNEMENT quand la source la donne ; sinon « Information datée du … » = date de
// PUBLICATION de la source citée (jamais présentée comme la date des faits) ; sinon « Date non établie » (exception, classée en dernier).
import { TYPE_LABELS } from '../lib/hub-matiere';
import { repere, trierChrono, trierSources } from '../../../scripts/lib/chronologie.mjs';
import { dateLongue } from '../lib/etat-wording';
import { libre } from '../lib/territoires';

interface Props { items: any[] }
const { items } = Astro.props;
const pub = (s: any) => (s?.publie_le ? dateLongue(s.publie_le) : null);
// Références COMPLÉMENTAIRES d'une étape : une même étape peut avoir plusieurs sources ; la principale n'efface pas les autres (une source devenue secondaire reste consultable).
const aussi = (e: any) => trierSources((e.sources_complementaires ?? []).filter((s: any) => s?.url && libre(s.media) && s.url !== e.source?.url), (s: any) => s?.publie_le);
const lignes = trierChrono(items).map((e: any) => ({ e, r: repere(e) }));
---

<ol class="chrono">
  {lignes.map(({ e, r }) => {
    return (
      <li class={`${r.sansDateEvenement ? 'sans-date ' : ''}t-${e.type}`} data-repere={r.nature} data-cle={r.cle ?? ''}>
        <div class="quand">{r.nature === 'information' ? <><span class="pfx">{r.prefixe}</span> <time datetime={r.date}>{r.valeur}</time></> : r.libelle}</div>
        <div class="quoi">
          <span class="type">{TYPE_LABELS[e.type] ?? e.type}</span>
          {e.acteur && <span class="acteur">{e.acteur}</span>}
          <p>{e.texte}</p>
          <p class="src">
            {e.source?.url
              ? <a href={e.source.url} target="_blank" rel="noopener noreferrer">{e.source.media}{pub(e.source) ? `, ${pub(e.source)}` : ''} ↗</a>
              : <span>{e.source?.media}{pub(e.source) ? `, ${pub(e.source)}` : ''} (lien non conservé)</span>}
            {e.source?.acces === 'paywall' && <span class="limite"> · article réservé aux abonnés</span>}
            {r.nature === 'information' && <span class="limite"> · date des faits non établie</span>}
            {r.nature === 'aucune' && <span class="limite"> · aucune date de publication exploitable</span>}
          </p>
          {aussi(e).length > 0 && (
            <p class="src aussi">Aussi : {aussi(e).map((s: any, k: number) => (<>{k > 0 ? ' · ' : ''}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.media}{pub(s) ? `, ${pub(s)}` : ''} ↗</a></>))}</p>
          )}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .chrono { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border); }
  .chrono li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 0 16px; padding: 0 0 14px 14px; position: relative; }
  .chrono li::before { content: ""; position: absolute; left: -6px; top: 5px; width: 10px; height: 10px;
    border-radius: 50%; background: var(--bg-card); border: 2px solid var(--blue); }
  .chrono li.sans-date::before { border-style: dashed; border-color: var(--muted); }
  .chrono li.t-decision::before { border-color: var(--green); background: var(--green); }
  .chrono li.t-appel::before { border-color: var(--orange); background: var(--orange); }
  .quand { font: 0.74rem/1.4 var(--mono); color: #3d3d42; padding-top: 2px; }
  .sans-date .quand { color: var(--muted); }
  .quand .pfx { display: inline; } .quand time { white-space: nowrap; }
  .type { display: inline-block; font: 0.64rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em;
    color: #55555b; background: #efefec; padding: 1px 6px; margin-right: 6px; }
  .acteur { font-size: 0.78rem; color: var(--muted); }
  .quoi p { margin: 3px 0 0; font-size: 0.9rem; line-height: 1.5; }
  .quoi p.src { font-size: 0.76rem; color: var(--muted); }
  .limite { font-style: italic; }
  @media (max-width: 600px) { .chrono li { grid-template-columns: 1fr; } .quand { margin-bottom: 2px; } }
</style>
