---
// Limites de la couverture : ce que le hub ne sait pas, et ce qui a été cherché.
// Le bloc générique est commun ; les inconnues et recherches viennent de la matière.
import { memoireCompileeLe } from '../lib/territoires';
import { dateLongue } from '../lib/etat-wording';

interface Props { inconnues?: string[]; recherches?: { question: string; resultat: string }[] }
const { inconnues = [], recherches = [] } = Astro.props;
---

<div class="limites">
  <div class="encart">
    <ul>
      {inconnues.map((i) => <li>{i}</li>)}
      <li>SNY ne documente que des affaires <strong>rapportées par la presse</strong> : l’absence d’une fiche n’est pas l’absence de faits.</li>
      <li>Fiches compilées le {dateLongue(memoireCompileeLe)}, sans date de vérification humaine enregistrée ; matière de cette page relue en octobre 2026 sur les articles cités.</li>
      <li>Ni palmarès, ni mesure de prévalence, ni indicateur de risque. Personnes mises en cause non nommées ; présomption d’innocence ; relaxes et classements traités avec la même attention.</li>
    </ul>
  </div>

  {recherches.length > 0 && (
    <details class="recherches">
      <summary>Ce que nous avons cherché</summary>
      <ul>{recherches.map((r) => <li><strong>{r.question}</strong> — {r.resultat}</li>)}</ul>
    </details>
  )}

  <p class="note">Une erreur, une évolution judiciaire, une relaxe, un classement ? <a href="mailto:contact@sousnosyeux.org">contact@sousnosyeux.org</a></p>
</div>

<style>
  .encart { max-width: 820px; padding: 0.9rem 1.1rem; background: var(--bg-card); border-left: 3px solid var(--orange); font-size: 0.88rem; color: #44444a; }
  .encart ul { margin: 0; padding-left: 1.2rem; }
  .encart li { margin: 4px 0; }
  .recherches { max-width: 820px; margin: 12px 0 0; font-size: 0.85rem; color: #4a4a50; }
  .recherches summary { cursor: pointer; font-weight: 600; }
  .recherches ul { margin: 6px 0 0; padding-left: 1.2rem; }
  .note { margin: 14px 0 0; font-size: 0.82rem; color: var(--muted); }
</style>
