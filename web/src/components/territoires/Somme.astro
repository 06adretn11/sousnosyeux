---
// Somme — territoire diffus. Public : aucune affaire validée, donc une page
// brève qui le dit sans en faire une garantie. Revue locale : la matière
// trouvée mais non validée (data/hub-prive/somme.json), classée par commune
// pour tester le format « département » — jamais publiable en l'état.
import Dossier from '../Dossier.astro';
import Reperes from '../Reperes.astro';
import Limites from '../Limites.astro';
import { chargerHub } from '../../lib/hub-matiere';

interface Props { publicOnly?: boolean }
const { publicOnly = false } = Astro.props;
const hub = chargerHub('somme');
const matiere = hub.matiere;
const prive = publicOnly ? null : hub.prive;

const communes: Record<string, any[]> = {};
if (prive) {
  for (const id of prive.ordre_avant) (communes[prive.communes[id]] ??= []).push({ c: prive.dossiers[id].fiche, d: prive.dossiers[id] });
}
---

<div class="terr">
  <p class="eyebrow">Territoire diffus · Somme (80){prive ? ' · version de revue' : ''}</p>
  <h1>{prive ? 'Somme : trois dossiers à décider' : 'Somme : aucune affaire documentée par SNY'}</h1>

  <Reperes r={prive?.reperes ?? matiere.reperes} />

  {prive && (
    <>
      <div class="alerte-prive">
        <strong>RENDU LOCAL — MATIÈRE NON VALIDÉE.</strong> Aucun de ces dossiers n’est validé ni publiable en l’état ;
        ils testent le format « département par communes ».
      </div>
      <h2>Dossiers, par commune</h2>
      {Object.entries(communes).map(([nom, items]) => (
        <section class="commune">
          <h3>{nom}</h3>
          <div class="grille">{items.map(({ c, d }) => <Dossier c={c} d={d} />)}</div>
        </section>
      ))}
    </>
  )}

  <h2>Limites et inconnues</h2>
  <Limites recherches={matiere.recherches} />
</div>

<style>
  .alerte-prive { max-width: 820px; margin: 1.2rem 0 0; padding: 0.7rem 1rem; border: 2px dashed var(--red); background: #fff5f5; font-size: 0.85rem; }
  .commune h3 { margin: 1.2rem 0 0.6rem; font: 700 1.25rem var(--display); }
</style>
