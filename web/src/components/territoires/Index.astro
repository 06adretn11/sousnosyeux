---
// Porte d'entrée de la prévisualisation : trois expériences, trois formats.
import { casesParIds } from '../../lib/territoires';

const nParis = casesParIds([
  'FR-2026-0016', 'FR-2026-0023', 'PARIS-006', 'PARIS-009',
  'POC-05', 'POC-06', 'POC-07', 'POC-08', 'POC-09',
]).length;
const nGironde = casesParIds(['FR-2026-0113']).length;

const cartes = [
  { href: '/brouillons/territoires/paris-11e', t: 'Paris 11e', k: 'Densité et complexité',
    d: `${nParis} fiches publiques : carte, filtre par état, décisions datées, fiches par établissement.` },
  { href: '/brouillons/territoires/bordeaux-gironde', t: 'Bordeaux / Gironde', k: 'Mémoire en construction',
    d: `${nGironde} fiche publique : lecture du dossier, sources, inconnues. Pas de carte.` },
  { href: '/brouillons/territoires/somme', t: 'Somme', k: 'Territoire diffus',
    d: 'Aucune fiche publique : une page qui assume le vide et refuse d’en faire une garantie.' },
];
---

<div class="terr">
  <p class="eyebrow">Prévisualisation · trois expériences territoriales</p>
  <h1>Trois formats, selon la matière</h1>
  <p class="lede">
    Chaque page est construite à partir des seules fiches publiques de SNY, sans rien ajouter. Les nombres
    ci-dessous décrivent la mémoire de SNY, pas la réalité des territoires : ils ne se comparent pas.
  </p>
  <div class="cartes">
    {cartes.map((c) => (
      <a class="carte" href={c.href}>
        <span class="k">{c.k}</span>
        <strong>{c.t}</strong>
        <span class="d">{c.d}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .cartes { display: grid; gap: 12px; grid-template-columns: repeat(3, 1fr); }
  .carte { display: flex; flex-direction: column; gap: 6px; padding: 1.1rem 1.2rem; background: var(--bg-card);
    border: 1px solid var(--border); border-top: 3px solid var(--red); color: inherit; text-decoration: none; }
  .carte:hover { border-color: #111; }
  .carte strong { font: 700 1.3rem var(--display); }
  .k { font: 0.68rem var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--red); }
  .d { font-size: 0.9rem; color: #55555b; }
  @media (max-width: 720px) { .cartes { grid-template-columns: 1fr; } }
</style>
