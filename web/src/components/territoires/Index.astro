---
// Porte d'entrée de la prévisualisation : trois expériences, trois formats,
// et pour chaque territoire à matière non publiée, la version publique seule.
import { casesParIds, idsAffichables } from '../../lib/territoires';
import { chargerHub } from '../../lib/hub-matiere';
import evenementsDoc from '../../../../data/evenements.json';

interface Props { base?: string; publique?: boolean }
const { base = '/brouillons/territoires', publique = false } = Astro.props;
const compter = (id: string) => {
  const { matiere, prive } = chargerHub(id);
  return { publiques: casesParIds(matiere._meta?.genere_auto ? idsAffichables(matiere.ordre) : matiere.ordre).length, privees: prive ? Object.keys(prive.dossiers).length : 0 };
};
const p = compter('paris-11e'), b = compter('bordeaux-gironde'), h = compter('hautes-alpes'), l = compter('landes');
const loc = (n: number) => (n > 0 ? ` + ${n} dossier${n > 1 ? 's' : ''} non publié${n > 1 ? 's' : ''} (rendu local)` : '');

const cartes = [
  { href: `${base}/paris-11e`, t: 'Paris 11e', k: 'Densité et complexité',
    d: `${p.publiques} fiches publiques : repères, tableau des procédures, carte, dossiers avec déroulé daté, détail des réponses des institutions.`,
    alt: null as null | { href: string; t: string } },
  { href: `${base}/bordeaux-gironde`, t: 'Bordeaux / Gironde', k: 'Densité intermédiaire',
    d: `${b.publiques} affaires (Frida-Kahlo, Cenon) : dossiers approfondis, procureur et élus nommés, versions divergentes mairie / association.`,
    alt: null },
  { href: `${base}/hautes-alpes`, t: 'Hautes-Alpes', k: 'Territoire peu dense',
    d: `${h.publiques} affaires, toutes deux jugées : lire ce que les tribunaux ont retenu et écarté, réponses du parquet et de l’enseignement catholique.`,
    alt: publique ? null : { href: `${base}/somme`, t: 'Somme : prototype écarté (aucune affaire validée) →' } },
  { href: `${base}/landes`, t: 'Landes', k: 'Territoire peu dense',
    d: `${l.publiques} affaires récentes (Tarnos, Mées), aucune jugée : déroulés sourcés, réponses du parquet, de la Ville et de l’Éducation nationale.`,
    alt: null },
  // Hubs composés puis approuvés (gabarit commun) : une carte chacun, sans édition de code.
  ...Object.entries((evenementsDoc as any).hubs_approuves ?? {}).filter(([s]) => !['paris-11e', 'bordeaux-gironde', 'hautes-alpes', 'landes'].includes(s)).map(([s, a]: [string, any]) => ({
    href: `${base}/${s}`, t: a.titre, k: 'Hub composé',
    d: `${compter(s).publiques} affaire(s) rapportée(s) par la presse : état, sources, réponses publiques documentées et ce que l’on ne sait pas.`, alt: null as null | { href: string; t: string } })),
];
---

<div class="terr">
  <p class="eyebrow">{publique ? 'Territoires' : 'Prévisualisation · trois expériences territoriales'}</p>
  <h1>{publique ? 'Comprendre les affaires par territoire' : 'Trois formats, selon la matière'}</h1>
  <p class="lede">
    Chaque page s’appuie sur les fiches publiques de SNY, enrichies d’une matière éditoriale relue source par source.
    Les nombres décrivent la mémoire de SNY, pas la réalité des territoires : ils ne se comparent pas.
  </p>
  <div class="cartes">
    {cartes.map((c) => (
      <div class="cellule">
        <a class="carte" href={c.href}>
          <span class="k">{c.k}</span>
          <strong>{c.t}</strong>
          <span class="d">{c.d}</span>
        </a>
        {c.alt && <a class="alt" href={c.alt.href}>{c.alt.t} →</a>}
      </div>
    ))}
  </div>
</div>

<style>
  .cartes { display: grid; gap: 12px; grid-template-columns: repeat(3, 1fr); }
  .cellule { display: flex; flex-direction: column; gap: 6px; }
  .carte { flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 1.1rem 1.2rem; background: var(--bg-card);
    border: 1px solid var(--border); border-top: 3px solid var(--red); color: inherit; text-decoration: none; }
  .carte:hover { border-color: #111; }
  .carte strong { font: 700 1.3rem var(--display); }
  .k { font: 0.68rem var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--red); }
  .d { font-size: 0.9rem; color: #55555b; }
  .alt { font-size: 0.8rem; color: var(--blue); }
  @media (max-width: 720px) { .cartes { grid-template-columns: 1fr; } }
</style>
