---
// Paris 11e — densité et complexité : plusieurs établissements, plusieurs
// procédures, deux décisions de relaxe frappées d'appel.
import FicheAffaire from '../FicheAffaire.astro';
import { casesParIds, memoireCompileeLe, STATUT_LABELS, statutCat, statutCourant } from '../../lib/territoires';
import { dateLongue } from '../../lib/etat-wording';

// Sélection explicite : les 9 fiches publiques du 11e arrondissement.
const cases = casesParIds([
  'FR-2026-0016', 'FR-2026-0023', 'PARIS-006', 'PARIS-009',
  'POC-05', 'POC-06', 'POC-07', 'POC-08', 'POC-09',
]);

// Un établissement = un point sur la carte (clé : coordonnées).
const parLieu = new Map<string, any[]>();
for (const c of cases) {
  const k = `${c.lat},${c.lng}`;
  parLieu.set(k, [...(parLieu.get(k) ?? []), c]);
}
const groupes = [...parLieu.values()].sort((a, b) =>
  a[0].etablissement.localeCompare(b[0].etablissement, 'fr'));

const etats = new Map<string, number>();
for (const c of cases) etats.set(statutCourant(c), (etats.get(statutCourant(c)) ?? 0) + 1);

// Décisions DATÉES (date de l'événement, pas de l'article) — les seules qu'on peut ordonner.
const datees = cases.filter((c) => c.etat?.date)
  .sort((a, b) => b.etat.date.localeCompare(a.etat.date));

const pins = groupes.map((g) => ({
  id: g[0].case_id.toLowerCase(),
  nom: g[0].etablissement.replace(/^École maternelle /, 'Maternelle '),
  lat: g[0].lat, lng: g[0].lng,
  cat: statutCat(statutCourant(g[0])),
  fiches: g.length,
}));
---

<div class="terr">
  <p class="eyebrow">Territoire dense · Paris 11e arrondissement</p>
  <h1>Affaires rapportées par la presse — Paris 11e</h1>
  <p class="lede">
    {cases.length} fiches publiques, {groupes.length} établissements. Chaque fiche dit où en est la procédure
    selon la presse, avec ses sources. Deux décisions de relaxe, frappées d’appel, y figurent au même
    rang que les mises en examen.
  </p>

  <div class="resume" role="list" aria-label="États des fiches">
    {[...etats.entries()].map(([s, n]) => (
      <span role="listitem" class={`pill ${statutCat(s)}`}><strong>{n}</strong> {STATUT_LABELS[s] ?? s}</span>
    ))}
  </div>

  {datees.length > 0 && (
    <>
      <h2>Décisions récentes datées</h2>
      <ul class="evol">
        {datees.map((c) => (
          <li>
            <a href={`#${c.case_id.toLowerCase()}`}>{c.etablissement}</a> —
            {STATUT_LABELS[c.etat.statut] ?? c.etat.statut} le {dateLongue(c.etat.date)}
            {(c.etat.suites ?? []).includes('APPEL_EN_COURS') && ' · appel en cours, décision non définitive'}.
          </li>
        ))}
      </ul>
      <p class="note">Seules ces décisions ont une date d’événement établie ; pour les autres fiches, la date de l’étape n’est pas connue de SNY.</p>
    </>
  )}

  <h2>Carte des établissements</h2>
  <div id="carte" role="region" aria-label="Carte des établissements du 11e"></div>
  <p class="note">
    Un point = un établissement cité par la presse. La carte ne mesure ni l’exhaustivité, ni un risque, et ne
    classe pas les établissements : l’absence d’un point ne signifie pas l’absence de faits.
  </p>
  <script type="application/json" id="pins-data" set:html={JSON.stringify(pins)} />

  <h2>Les fiches</h2>
  <div class="filtres" role="group" aria-label="Filtrer par état">
    <button type="button" data-f="" aria-pressed="true">Toutes ({cases.length})</button>
    {[...etats.entries()].map(([s, n]) => (
      <button type="button" data-f={s} aria-pressed="false">{STATUT_LABELS[s] ?? s} ({n})</button>
    ))}
  </div>

  <div class="grille" id="liste">
    {groupes.map((g) => (
      <section class="groupe">
        {g.length > 1 && (
          <p class="note multi">
            Deux fiches existent pour cet établissement, issues de sources différentes.
            SNY n’a pas établi s’il s’agit d’une seule procédure ou de deux : elles sont comptées comme
            {' '}{g.length} fiches mais un seul établissement.
          </p>
        )}
        {g.map((c) => <FicheAffaire c={c} detail />)}
      </section>
    ))}
  </div>

  <h2>Limites de cette couverture</h2>
  <div class="encart limites">
    <ul>
      <li>SNY ne documente que des affaires <strong>rapportées par la presse en ligne</strong> : des faits peuvent exister sans article, ou dans un article que SNY n’a pas retenu.</li>
      <li>Mémoire compilée le {dateLongue(memoireCompileeLe)}. Aucune date de vérification humaine n’est enregistrée sur ces fiches : un fait postérieur à leur dernière source peut manquer.</li>
      <li>Cette page n’est ni un palmarès, ni une mesure de prévalence : le nombre de fiches ne dit rien de la sécurité d’un quartier ou d’une école.</li>
      <li>Aucune personne mise en cause n’est nommée ; les faits sont attribués à leurs sources, sous présomption d’innocence.</li>
    </ul>
  </div>
  <p class="note">Une erreur, une relaxe, un classement ou une évolution à signaler ? <a href="mailto:contact@sousnosyeux.org">contact@sousnosyeux.org</a></p>
</div>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const pins: { id: string; nom: string; lat: number; lng: number; cat: string; fiches: number }[] =
    JSON.parse(document.getElementById('pins-data')!.textContent!);
  const COUL: Record<string, string> = { red: '#E63946', blue: '#457B9D', orange: '#D97706', green: '#2D6A4F' };

  const map = new maplibregl.Map({
    container: 'carte',
    style: {
      version: 8,
      sources: { osm: { type: 'raster', tileSize: 256,
        tiles: ['https://a.tile.openstreetmap.org/{z}/{x}/{y}.png', 'https://b.tile.openstreetmap.org/{z}/{x}/{y}.png'],
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' } },
      layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
    },
    center: [2.38, 48.858], zoom: 13,
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  map.addControl(new maplibregl.AttributionControl({ compact: true }));

  const bounds = new maplibregl.LngLatBounds();
  for (const p of pins) {
    const el = document.createElement('button');
    el.type = 'button';
    el.setAttribute('aria-label', `${p.nom} — voir la fiche`);
    el.style.cssText = `width:18px;height:18px;border-radius:50%;border:2px solid #fff;cursor:pointer;padding:0;box-shadow:0 1px 4px rgba(0,0,0,.4);background:${COUL[p.cat]}`;
    const pop = new maplibregl.Popup({ offset: 12, closeButton: false });
    const box = document.createElement('div');
    const t = document.createElement('strong'); t.textContent = p.nom;
    const a = document.createElement('a'); a.href = `#${p.id}`; a.textContent = 'Voir la fiche ↓';
    a.style.cssText = 'display:block;margin-top:4px;font-size:.85rem';
    box.append(t, a); pop.setDOMContent(box);
    new maplibregl.Marker({ element: el }).setLngLat([p.lng, p.lat]).setPopup(pop).addTo(map);
    bounds.extend([p.lng, p.lat]);
  }
  map.fitBounds(bounds, { padding: 50, maxZoom: 15, duration: 0 });

  // Filtre par état : masque fiches et groupes vides, rien d'autre.
  const boutons = [...document.querySelectorAll<HTMLButtonElement>('.filtres button')];
  const fiches = [...document.querySelectorAll<HTMLElement>('#liste .fiche')];
  const groupes = [...document.querySelectorAll<HTMLElement>('#liste .groupe')];
  for (const b of boutons) {
    b.addEventListener('click', () => {
      const f = b.dataset.f ?? '';
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      fiches.forEach((el) => { el.hidden = f !== '' && el.dataset.statut !== f; });
      groupes.forEach((g) => { g.hidden = [...g.querySelectorAll<HTMLElement>('.fiche')].every((el) => el.hidden); });
    });
  }
</script>

<style>
  .resume { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 0.5rem; }
  .pill { padding: 5px 10px; font-size: 0.84rem; background: #eef2f5; }
  .pill strong { font: 500 1.05rem var(--mono); margin-right: 4px; }
  .pill.red { background: var(--red-bg); } .pill.blue { background: var(--blue-bg); }
  .pill.orange { background: var(--orange-bg); } .pill.green { background: var(--green-bg); }
  .evol { margin: 0 0 6px; padding-left: 1.1rem; font-size: 0.92rem; }
  .evol li { margin: 4px 0; }
  .note { max-width: 780px; margin: 6px 0 0; color: var(--muted); font-size: 0.8rem; }
  .note.multi { padding: 8px 12px; background: var(--orange-bg); color: #6b4408; margin: 0 0 8px; }
  #carte { height: 380px; border: 1px solid var(--border); background: #e9e9e6; }
  .filtres { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .filtres button { padding: 6px 11px; border: 1px solid var(--border); background: #fff; font: 0.78rem var(--sans); cursor: pointer; }
  .filtres button[aria-pressed="true"] { background: #111; color: #fff; border-color: #111; }
  .groupe { display: grid; gap: 8px; }
  [hidden] { display: none !important; }
  @media (max-width: 560px) { #carte { height: 300px; } }
</style>
