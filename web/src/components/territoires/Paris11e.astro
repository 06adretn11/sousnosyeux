---
// Paris 11e — densité et complexité : plusieurs établissements, plusieurs
// procédures à des stades différents, deux relaxes frappées d'appel,
// et un volet institutionnel documenté. Toutes les affaires sont publiques.
import Dossier from '../Dossier.astro';
import Reperes from '../Reperes.astro';
import Reponses from '../Reponses.astro';
import Limites from '../Limites.astro';
import { casesParIds, STATUT_LABELS, statutCat } from '../../lib/territoires';
import { chargerHub, libelleDate, TYPE_LABELS } from '../../lib/hub-matiere';
import { dateLongue } from '../../lib/etat-wording';

const { matiere } = chargerHub('paris-11e');
const cases = casesParIds(matiere.ordre);
const D = matiere.dossiers;
const statutDe = (c: any) => D[c.case_id]?.statut_affiche ?? c.etat?.statut ?? c.statut_judiciaire;

// Un établissement = un point sur la carte (clé : coordonnées), ordre = avancement procédural.
const groupes: any[][] = [];
const parLieu = new Map<string, any[]>();
for (const c of cases) {
  const k = `${c.lat},${c.lng}`;
  if (!parLieu.has(k)) { const g: any[] = []; parLieu.set(k, g); groupes.push(g); }
  parLieu.get(k)!.push(c);
}

const etats = new Map<string, number>();
for (const c of cases) etats.set(statutDe(c), (etats.get(statutDe(c)) ?? 0) + 1);

// Dernière ÉTAPE PROCÉDURALE datée (date d'événement, jamais date d'article ; une mobilisation n'est pas une étape).
const dernier = (c: any) => (D[c.case_id]?.deroule ?? [])
  .filter((e: any) => e.date && e.date_nature === 'evenement' && e.date <= '2026-10-10' && !['mobilisation', 'prise_de_parole', 'contradiction', 'contexte'].includes(e.type))
  .sort((a: any, b: any) => b.date.localeCompare(a.date))[0] ?? null;

const pins = groupes.map((g) => ({
  id: g[0].case_id.toLowerCase(),
  nom: g[0].etablissement.replace(/^École maternelle /, 'Maternelle '),
  lat: g[0].lat, lng: g[0].lng,
  cat: statutCat(statutDe(g[0])),
}));
---

<div class="terr">
  <p class="eyebrow">Territoire dense · Paris 11e arrondissement</p>
  <h1>Comprendre les affaires du 11e arrondissement</h1>


  <Reperes r={matiere.reperes}>
    <Reponses groupes={matiere.reponses} />
  </Reperes>

  <h2>Où en sont les procédures</h2>
  <div class="resume" role="list" aria-label="États des fiches">
    {[...etats.entries()].map(([s, n]) => (
      <span role="listitem" class={`pill ${statutCat(s)}`}><strong>{n}</strong> {STATUT_LABELS[s] ?? s}</span>
    ))}
  </div>
  <div class="tablewrap">
    <table class="tab">
      <thead><tr><th>Établissement</th><th>État rapporté</th><th>Dernière étape datée</th></tr></thead>
      <tbody>
        {cases.map((c) => {
          const d = dernier(c);
          return (
            <tr>
              <td><a href={`#${c.case_id.toLowerCase()}`}>{c.etablissement}</a></td>
              <td>
                <span class={`chip ${statutCat(statutDe(c))}`}>{STATUT_LABELS[statutDe(c)] ?? statutDe(c)}</span>
                {(c.etat?.suites ?? []).includes('APPEL_EN_COURS') && <span class="chip appel">appel</span>}
              </td>
              <td>{d ? `${TYPE_LABELS[d.type] ?? d.type}, ${dateLongue(d.date)}` : 'aucune étape datée connue'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="note">Ordre : avancement procédural, jamais gravité. « Aucune étape datée » veut dire que les sources lues ne datent pas l’étape, pas qu’il ne s’est rien passé.</p>

  <details class="carte-bloc" id="carte-bloc" open>
    <summary>Carte des établissements</summary>
    <div id="carte" role="region" aria-label="Carte des établissements du 11e"></div>
    <p class="note">
      Un point = un établissement cité par la presse. La carte ne mesure ni l’exhaustivité, ni un risque, et ne classe
      pas les établissements : l’absence d’un point ne signifie pas l’absence de faits.
    </p>
  </details>
  <script type="application/json" id="pins-data" set:html={JSON.stringify(pins)} />

  <h2>Les dossiers</h2>
  <div class="filtres" role="group" aria-label="Filtrer par état">
    <button type="button" data-f="" aria-pressed="true">Tous ({cases.length})</button>
    {[...etats.entries()].map(([s, n]) => (
      <button type="button" data-f={s} aria-pressed="false">{STATUT_LABELS[s] ?? s} ({n})</button>
    ))}
  </div>

  <div class="grille" id="liste">
    {groupes.map((g) => (
      <section class="groupe">
        {g.length > 1 && (
          <p class="note multi">
            Deux fiches existent pour cet établissement. Les sources lues ne permettent pas d’établir s’il s’agit d’une
            seule procédure ou de deux : elles sont comptées comme {g.length} fiches mais un seul établissement.
          </p>
        )}
        {g.map((c) => <Dossier c={c} d={D[c.case_id]} />)}
      </section>
    ))}
  </div>

  <h2>Limites et inconnues</h2>
  <Limites inconnues={matiere.inconnues_transversales} recherches={matiere.recherches} />
</div>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const pins: { id: string; nom: string; lat: number; lng: number; cat: string }[] =
    JSON.parse(document.getElementById('pins-data')!.textContent!);
  const COUL: Record<string, string> = { red: '#E63946', blue: '#457B9D', orange: '#D97706', green: '#2D6A4F' };

  // Carte repliée par défaut sur mobile : elle ne retarde plus l'accès aux dossiers ; initialisée à l'ouverture.
  const bloc = document.getElementById('carte-bloc') as HTMLDetailsElement;
  if (matchMedia('(max-width: 720px)').matches) bloc.open = false;
  let map: maplibregl.Map | null = null;
  function initCarte() {
  if (map) { map.resize(); return; }
  map = new maplibregl.Map({
    container: 'carte',
    style: {
      version: 8,
      sources: { osm: { type: 'raster', tileSize: 256,
        tiles: ['https://a.tile.openstreetmap.org/{z}/{x}/{y}.png', 'https://b.tile.openstreetmap.org/{z}/{x}/{y}.png'],
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' } },
      layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
    },
    center: [2.38, 48.858], zoom: 13,
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  map.addControl(new maplibregl.AttributionControl({ compact: true }));

  const bounds = new maplibregl.LngLatBounds();
  for (const p of pins) {
    const el = document.createElement('button');
    el.type = 'button';
    el.setAttribute('aria-label', `${p.nom} — voir le dossier`);
    el.style.cssText = `width:18px;height:18px;border-radius:50%;border:2px solid #fff;cursor:pointer;padding:0;box-shadow:0 1px 4px rgba(0,0,0,.4);background:${COUL[p.cat]}`;
    const pop = new maplibregl.Popup({ offset: 12, closeButton: false });
    const box = document.createElement('div');
    const t = document.createElement('strong'); t.textContent = p.nom;
    const a = document.createElement('a'); a.href = `#${p.id}`; a.textContent = 'Voir le dossier ↓';
    a.style.cssText = 'display:block;margin-top:4px;font-size:.85rem';
    box.append(t, a); pop.setDOMContent(box);
    new maplibregl.Marker({ element: el }).setLngLat([p.lng, p.lat]).setPopup(pop).addTo(map);
    bounds.extend([p.lng, p.lat]);
  }
  map.fitBounds(bounds, { padding: 50, maxZoom: 15, duration: 0 });
  }
  if (bloc.open) initCarte();
  bloc.addEventListener('toggle', () => { if (bloc.open) initCarte(); });

  // Filtre par état : masque dossiers et groupes vides, rien d'autre.
  const boutons = [...document.querySelectorAll<HTMLButtonElement>('.filtres button')];
  const fiches = [...document.querySelectorAll<HTMLElement>('#liste .dossier')];
  const groupes = [...document.querySelectorAll<HTMLElement>('#liste .groupe')];
  for (const b of boutons) {
    b.addEventListener('click', () => {
      const f = b.dataset.f ?? '';
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      fiches.forEach((el) => { el.hidden = f !== '' && el.dataset.statut !== f; });
      groupes.forEach((g) => { g.hidden = [...g.querySelectorAll<HTMLElement>('.dossier')].every((el) => el.hidden); });
    });
  }
</script>

<style>
  .resume { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
  .pill { padding: 5px 10px; font-size: 0.84rem; background: #eef2f5; }
  .pill strong { font: 500 1.05rem var(--mono); margin-right: 4px; }
  .pill.red { background: var(--red-bg); } .pill.blue { background: var(--blue-bg); }
  .pill.orange { background: var(--orange-bg); } .pill.green { background: var(--green-bg); }
  .tablewrap { overflow-x: auto; }
  .tab { width: 100%; max-width: 900px; border-collapse: collapse; background: var(--bg-card); font-size: 0.88rem; }
  .tab th, .tab td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .tab th { font: 0.68rem var(--mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .tab a { color: var(--blue); }
  .chip { display: inline-block; padding: 2px 7px; margin-right: 4px; font: 0.68rem var(--mono); background: #eef2f5; color: #3f5c6c; }
  .chip.red { background: var(--red-bg); color: #9b1c28; } .chip.blue { background: var(--blue-bg); color: #1e4a6b; }
  .chip.orange { background: var(--orange-bg); color: #92500a; } .chip.green { background: var(--green-bg); color: #1b4d38; }
  .chip.appel { background: #fff; color: #92500a; border: 1px solid var(--orange); }
  .note { max-width: 780px; margin: 6px 0 0; color: var(--muted); font-size: 0.8rem; }
  .note.multi { padding: 8px 12px; background: var(--orange-bg); color: #6b4408; margin: 0 0 8px; }
  .carte-bloc { margin: 0 0 0.5rem; }
  .carte-bloc summary { cursor: pointer; font: 400 0.76rem var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: #6b6b72; padding: 8px 0; border-bottom: 1px solid var(--border); margin-bottom: 10px; }
  #carte { height: 380px; border: 1px solid var(--border); background: #e9e9e6; }
  .tab { font-size: 0.82rem; }
  .tab th, .tab td { padding: 6px 9px; }
  .filtres { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .filtres button { padding: 6px 11px; border: 1px solid var(--border); background: #fff; font: 0.78rem var(--sans); cursor: pointer; }
  .filtres button[aria-pressed="true"] { background: #111; color: #fff; border-color: #111; }
  .groupe { display: grid; gap: 8px; }
  [hidden] { display: none !important; }
  @media (max-width: 560px) {
    #carte { height: 300px; }
    .tab th:nth-child(3), .tab td:nth-child(3) { display: none; }
    .tab td, .tab th { padding: 5px 7px; }
  }
</style>
