---
// Réponses institutionnelles : ce que les institutions ONT DIT ou FAIT,
// attribué. Jamais une conclusion de SNY sur leur responsabilité.
import { libelleDate } from '../lib/hub-matiere';
import { dateLongue } from '../lib/etat-wording';

interface Props { groupes: { titre: string; items: any[] }[] }
const { groupes } = Astro.props;
---

<div class="reps">
  {groupes.map((g) => (
    <section>
      <h3>{g.titre}</h3>
      <ul>
        {g.items.map((r) => (
          <li>
            <span class="quand">{libelleDate(r.date, r.date_nature)}</span>
            <span class="acteur">{r.acteur}</span>
            <p>{r.texte}</p>
            <p class="src">
              {r.source?.url
                ? <a href={r.source.url} target="_blank" rel="noopener noreferrer">{r.source.media}{r.source.publie_le ? `, ${dateLongue(r.source.publie_le)}` : ''} ↗</a>
                : <span>{r.source?.media}</span>}
              {r.source?.acces === 'paywall' && <span> · réservé aux abonnés</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .reps { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .reps section { background: var(--bg-card); border: 1px solid var(--border); border-top: 3px solid var(--blue); padding: 0.9rem 1.1rem; }
  h3 { margin: 0 0 8px; font: 700 1rem var(--sans); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .quand { font: 0.72rem var(--mono); color: #3d3d42; margin-right: 8px; }
  .acteur { font-size: 0.8rem; font-weight: 600; }
  p { margin: 3px 0 0; font-size: 0.88rem; line-height: 1.5; }
  p.src { font-size: 0.74rem; color: var(--muted); }
</style>
